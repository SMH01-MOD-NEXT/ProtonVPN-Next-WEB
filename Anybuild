# Wasmer must run the Node mirror and proxy, not Vite's static-only output.
# Copy the complete source before npm ci to work around Anybuild 0.28.2
# staging package-lock.json without package.json in its narrow install layer.

load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "install": "npm ci",
        "build": "npm run build",
        "start": "node server.js",
    },
    node_package_manager = "npm",
    node_framework = "vite",
    node_server = "node",
    node_build_command = "npm run build",
    node_version = "24",
    node_install_requires_all_files = True,
)

build = node_build(config)

node_serve(config, build, name = "protonvpn-next-web")
