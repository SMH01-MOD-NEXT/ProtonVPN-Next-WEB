{
  "version": 2,
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "authorization,content-type,x-pm-appversion,x-pm-apiversion,x-pm-uid,x-pm-locale,x-pm-human-verification-token,x-pm-human-verification-token-type,user-agent" },
        { "key": "Access-Control-Expose-Headers", "value": "x-pvpn-quota,x-pvpn-quota-limit,x-pvpn-quota-remaining,x-pvpn-quota-reset,x-pvpn-quota-state" }
      ]
    }
  ]
}
